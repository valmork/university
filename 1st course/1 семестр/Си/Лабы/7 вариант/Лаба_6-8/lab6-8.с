void add(int* n, struct prod** s)   
{                                     
	*n = *n + 1;                      
	*s = (struct prod*)realloc(*s, *n * sizeof(struct prod));
	printf("Введите код нового продавца: \n");
	int a = 0;
	do {
		scanf("%d", &a);
		getchar();
		for (int i = 0; i < *n; i++)
			if (((*s + i)->num) == a)
			{
				printf("Введите другой код\n");
				a = 0;
			}
	} while (a == 0);
	(*s + *n - 1)->num = a;
	printf("Введите фамилию\n");
	gets((*(*s + *n - 1)).familiya);
	printf("Введите имя\n");
	gets((*s + *n - 1)->name);
    printf("Введите отчество\n");
	gets((*s + *n - 1)->surname);
    printf("Введите адрес\n");
	gets((*s + *n - 1)->address);
	printf("Введите пол.\n");
	gets((*s + *n - 1)->gender);
	printf("Введите телефон.\n");
	scanf("%u", &((*s + *n - 1)->phone));
	getchar();
	printf("Введите дату рождения продавца (формат - ДД.ММ.ГГГГ)\n");
	scanf("%d.%d.%u", &(*s + *n - 1)->date2.day, &(*s + *n - 1)->date2.month, &(*s + *n - 1)->date2.year);
}

struct prod*
	del(int a, int* n, struct prod* Pr)  // начало 2 подпрограммы
{
	for (int i = 0; i < *n; i++)
	{
		if (Pr[i].num == a)
		{
			for (int j = i; j < *n; j++)
			{
				Pr[j] = Pr[j + 1];
			}
			*n = *n - 1;
			Pr = (struct prod*)realloc(Pr, *n * sizeof(struct prod));
			break;
		}
	}
	return Pr;
}

